{
  "name": "@kite-01/server",
  "version": "1.0.0",
  "description": "Open source crypto payment processor",
  "main": "src/index.ts",
  "scripts": {
    "test": "bunx --bun vitest run",
    "check": "tsc --noEmit",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "build": "bun run check && bun install --cwd client --frozen-lockfile && bun run --cwd client build",
    "dev": "KITE_ENABLE_DASHBOARD=true bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:studio": "bunx --bun drizzle-kit studio",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "migrate": "bun src/db/migrate.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kite-01/server.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Kite-01/server/issues"
  },
  "homepage": "https://github.com/Kite-01/server#readme",
  "devDependencies": {
    "@types/bun": "1.3.0",
    "@types/lodash": "4.17.25",
    "@types/node": "26.6.2",
    "drizzle-kit": "0.31.11",
    "elysia-vite-server": "0.0.1",
    "embedded-postgres": "18.4.0-beta.17",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@alchemy/wallet-apis": "5.2.7",
    "@elysiajs/node": "1.4.5",
    "@elysiajs/openapi": "1.4.16",
    "@kite-01/contracts": "1.0.4",
    "@sinclair/typebox": "0.34.52",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "axios": "1.20.0",
    "dotenv": "18.0.4",
    "drizzle-orm": "0.45.3",
    "elysia": "1.4.30",
    "lodash": "4.18.1",
    "pg-boss": "12.36.0",
    "postgres": "3.4.9",
    "undici": "8.11.2",
    "viem": "2.56.9",
    "zod": "4.6.5"
  },
  "trustedDependencies": [
    "@embedded-postgres/linux-x64"
  ]
}
